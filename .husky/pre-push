#!/bin/sh
set -e

ROOT="$(git rev-parse --show-toplevel)"

echo "── Frontend: tests ──────────────────────────────"
(cd "$ROOT/worthygoals-frontend-app" && yarn jest --ci --passWithNoTests)

echo "── Backend: tests ───────────────────────────────"
(cd "$ROOT/worthygoals-backend" && npm test -- --passWithNoTests --testPathIgnorePatterns='.*\.e2e-spec\.ts$')

echo "✓ pre-push passed"
