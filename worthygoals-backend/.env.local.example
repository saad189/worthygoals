# Copy to .env.local and fill in your values

# Server
PORT=3000
SERVER_URL=http://localhost

# Database (PostgreSQL — local dev)
# Run: docker run --name pg -e POSTGRES_PASSWORD=postgres -p 5432:5432 -d pgvector/pgvector:pg16
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=worthygoals

# AWS Cognito
AWS_REGION=
AWS_COGNITO_USER_POOL_ID=
AWS_COGNITO_CLIENT_ID=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# OpenAI
OPENAI_API_KEY=

# Sentry — https://sentry.io → your project → Settings → Client Keys
SENTRY_DSN=
