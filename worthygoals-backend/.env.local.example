# Copy to .env.local and fill in your values.
# Every key here matches src/config/env.validation.ts exactly — the previous
# copy named AWS_COGNITO_CLIENT_ID, which the schema does not accept, so
# copying it verbatim failed to boot.

# Server
PORT=3000
SERVER_URL=http://localhost

# Database (PostgreSQL + pgvector — local dev)
# Run: docker run --name pg -e POSTGRES_PASSWORD=postgres -p 5432:5432 -d pgvector/pgvector:pg16
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=worthygoals
# Full SQL logging leaks PII (emails, goal text) — leave off unless debugging.
DB_LOGGING=false
# Managed Postgres needs SSL; local dev does not.
DB_SSL=false

# AWS Cognito
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_COGNITO_USER_POOL_ID=
AWS_COGNITO_APP_CLIENT_ID=
# Only if your app client has a secret enabled. Leave blank otherwise —
# SECRET_HASH is then omitted rather than sent empty.
AWS_COGNITO_APP_CLIENT_SECRET=

# AI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
AI_ACTIVE_PROVIDER=openai
# Optional second provider — graceful no-op when absent.
ANTHROPIC_API_KEY=
# Optional JSON map of model -> { in, out } cost per million tokens.
AI_MODEL_COSTS_JSON=

# Push notifications
REDIS_URL=redis://localhost:6379
EXPO_ACCESS_TOKEN=

# Media storage (S3 / R2) — optional, graceful no-op when absent
S3_ENDPOINT=
S3_BUCKET_NAME=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto

# CORS — comma-separated origins. Required in prod; all origins allowed in dev.
ALLOWED_ORIGINS=

# Observability — optional
SENTRY_DSN=
SUPPORT_EMAIL_SENDER=
