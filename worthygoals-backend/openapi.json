  "info": {
    "title": "Worthy Goals API",
    "description": "Backend Server API",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "UpdateUserDto": {
        "type": "object",
        "properties": {}
      },
      "CreateUserDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "user@example.com",
            "description": "The email address of the user"
          },
          "firstName": {
            "type": "string",
            "example": "John",
            "description": "The first name of the user"
          },
          "lastName": {
            "type": "string",
            "example": "Doe",
            "description": "The last name of the user"
          },
          "dateOfBirth": {
            "type": "string",
            "example": "1990-01-01",
            "description": "The date of birth of the user"
          },
          "gender": {
            "type": "string",
            "example": "m",
            "description": "The gender of the user"
          },
          "latitude": {
            "type": "number",
            "example": 37.7749,
            "description": "The latitude of the user's location"
          },
          "longitude": {
            "type": "number",
            "example": -122.4194,
            "description": "The longitude of the user's location"
          },
          "tone": {
            "type": "string",
            "example": "firm",
            "description": "The user's onboarding tone preference (forced-choice deck result)"
          },
          "personalityId": {
            "type": "string",
            "example": "marcus",
            "description": "The user's onboarding-matched mentor (personality slug)"
          }
        },
        "required": [
          "email"
        ]
      },
      "LoginAuthDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "user@example.com",
            "description": "The email of the user"
          },
          "password": {
            "type": "string",
            "example": "Str0ngP@ssw0rd!",
            "description": "The password of the user"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "RefreshTokenDto": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string",
            "example": "708c49fc-c031-7162-c945-84722ffc91a4",
            "description": "The username of the requesting user"
          },
          "refreshToken": {
            "type": "string",
            "description": "refresh token"
          }
        },
        "required": [
          "username",
          "refreshToken"
        ]
      },
      "SignUpAuthDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "user@example.com",
            "description": "The email of the user"
          },
          "password": {
            "type": "string",
            "example": "Str0ngP@ssw0rd!",
            "description": "The password of the user"
          },
          "repeatedPassword": {
            "type": "string",
            "example": "Str0ngP@ssw0rd!",
            "description": "The repeated password of the user"
          }
        },
        "required": [
          "email",
          "password",
          "repeatedPassword"
        ]
      },
      "ConfirmSignUpDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "user@example.com",
            "description": "The email of the user"
          },
          "code": {
            "type": "string",
            "description": "The confirmation code received by the user",
            "example": "123456"
          }
        },
        "required": [
          "email",
          "code"
        ]
      },
      "ConfirmationCodeDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "user@example.com",
            "description": "The email of the user"
          }
        },
        "required": [
          "email"
        ]
      },
      "ConfirmPasswordDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "user@example.com",
            "description": "The email of the user"
          },
          "code": {
            "type": "string",
            "description": "The confirmation code received by the user",
            "example": "123456"
          },
          "password": {
            "type": "string",
            "example": "NewStr0ngP@ssw0rd!",
            "description": "The new password of the user"
          },
          "repeatedPassword": {
            "type": "string",
            "example": "Str0ngP@ssw0rd!",
            "description": "The repeated password of the user"
          }
        },
        "required": [
          "email",
          "code",
          "password",
          "repeatedPassword"
        ]
      },
      "CreateConversationDto": {
        "type": "object",
        "properties": {}
      },
      "UpdateConversationDto": {
        "type": "object",
        "properties": {}
      },
      "SendTextMessageDto": {
        "type": "object",
        "properties": {}
      },
      "ProposeGoalDto": {
        "type": "object",
        "properties": {
          "raw": {
            "type": "string",
            "example": "I want to run a half-marathon by October"
          }
        },
        "required": [
          "raw"
        ]
      },
      "CreateGoalDto": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "example": "20-minute morning run"
          },
          "description": {
            "type": "string"
          },
          "category": {
            "type": "string",
            "enum": [
              "power",
              "knowledge",
              "spiritual"
            ],
            "default": "power"
          },
          "mentorId": {
            "type": "number",
            "example": 1
          },
          "costText": {
            "type": "string"
          },
          "benefitText": {
            "type": "string"
          },
          "failureText": {
            "type": "string"
          },
          "deadline": {
            "type": "string",
            "example": "2026-12-31T00:00:00.000Z"
          },
          "repeatRule": {
            "type": "object",
            "example": {
              "frequency": "daily"
            }
          },
          "stakeAmount": {
            "type": "number",
            "example": 50
          },
          "imageUri": {
            "type": "string"
          }
        },
        "required": [
          "title"
        ]
      },
      "UpdateGoalDto": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "example": "20-minute morning run"
          },
          "description": {
            "type": "string"
          },
          "category": {
            "type": "string",
            "enum": [
              "power",
              "knowledge",
              "spiritual"
            ],
            "default": "power"
          },
          "mentorId": {
            "type": "number",
            "example": 1
          },
          "costText": {
            "type": "string"
          },
          "benefitText": {
            "type": "string"
          },
          "failureText": {
            "type": "string"
          },
          "deadline": {
            "type": "string",
            "example": "2026-12-31T00:00:00.000Z"
          },
          "repeatRule": {
            "type": "object",
            "example": {
              "frequency": "daily"
            }
          },
          "stakeAmount": {
            "type": "number",
            "example": 50
          },
          "imageUri": {
            "type": "string"
          }
        }
      },
      "CreateUploadUrlDto": {
        "type": "object",
        "properties": {}
      },
      "CreateTaskDto": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "example": "Morning 5km run"
          },
          "goalId": {
            "type": "string",
            "example": "goal-uuid-here"
          },
          "description": {
            "type": "string"
          },
          "dueDate": {
            "type": "string",
            "example": "2026-06-01T07:00:00.000Z"
          },
          "repeatFrequency": {
            "type": "string",
            "enum": [
              "none",
              "daily",
              "weekly",
              "monthly"
            ],
            "default": "none"
          }
        },
        "required": [
          "title",
          "goalId"
        ]
      },
      "UpdateTaskDto": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "example": "Morning 5km run"
          },
          "description": {
            "type": "string"
          },
          "dueDate": {
            "type": "string",
            "example": "2026-06-01T07:00:00.000Z"
          },
          "repeatFrequency": {
            "type": "string",
            "enum": [
              "none",
              "daily",
              "weekly",
              "monthly"
            ],
            "default": "none"
          }
        }
      },
      "CompleteTaskDto": {
        "type": "object",
        "properties": {
          "moodScore": {
            "type": "number",
            "minimum": 1,
            "maximum": 4,
            "example": 3
          },
          "reflection": {
            "type": "string"
          },
          "memoryPictureId": {
            "type": "string",
            "description": "UUID of an uploaded media item (M06)"
          },
          "personalityId": {
            "type": "string",
            "description": "Personality ID for mentor reaction generation"
          }
        },
        "required": [
          "moodScore"
        ]
      },
      "ExplainTaskDto": {
        "type": "object",
        "properties": {
          "reason": {
            "type": "string",
            "enum": [
              "couldnt",
              "forgot",
              "chose_not_to"
            ]
          },
          "freeText": {
            "type": "string"
          },
          "personalityId": {
            "type": "string",
            "description": "Personality ID for mentor reaction generation"
          }
        },
        "required": [
          "reason"
        ]
      },
      "RegisterTokenDto": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "example": "ExponentPushToken[xxxxxxxxxxxxxxxxxxxxxx]"
          },
          "platform": {
            "type": "string",
            "enum": [
              "expo",
              "fcm",
              "apns"
            ],
            "default": "expo"
          },
          "timezone": {
            "type": "string",
            "example": "America/New_York"
          }
        },
        "required": [
          "token"
        ]
      },
      "UnregisterTokenDto": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "example": "ExponentPushToken[xxxxxxxxxxxxxxxxxxxxxx]"
          }
        },
        "required": [
          "token"
        ]
      },
      "BoardItemDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "win",
              "milestone"
            ]
          },
          "taskTitle": {
            "type": "string"
          },
          "goalTitle": {
            "type": "string"
          },
          "goalCategory": {
            "type": "string"
          },
          "moodScore": {
            "type": "number"
          },
          "reflection": {
            "type": "string"
          },
          "mentorReaction": {
            "type": "string"
          },
          "mediaUrl": {
            "type": "string"
          },
          "milestoneKind": {
            "type": "string",
            "enum": [
              "streak_7",
              "streak_30",
              "goal_completed"
            ]
          },
          "streakDays": {
            "type": "number"
          },
          "createdAt": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "id",
          "type",
          "createdAt"
        ]
      },
      "StatusReactionDto": {
        "type": "object",
        "properties": {
          "personalityId": {
            "type": "string",
            "description": "personalityId slug (marcus / lyra / goggs)."
          },
          "mentorName": {
            "type": "string",
            "description": "Mentor display name."
          },
          "text": {
            "type": "string",
            "description": "The in-voice reaction text."
          }
        },
        "required": [
          "personalityId",
          "mentorName",
          "text"
        ]
      },
      "StatusPostDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "createdAt": {
            "format": "date-time",
            "type": "string"
          },
          "imageUrl": {
            "type": "object",
            "description": "Presigned GET url for the attached photo, if any.",
            "nullable": true
          },
          "reactions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/StatusReactionDto"
            }
          },
          "safetyFlag": {
            "type": "boolean",
            "description": "Set when the status tripped the crisis gate: no mentor reactions were generated."
          },
          "crisisResponse": {
            "type": "string",
            "description": "The safe response with crisis resources, when safetyFlag."
          }
        },
        "required": [
          "id",
          "text",
          "createdAt",
          "reactions"
        ]
      },
      "CreateStatusDto": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "description": "The free-text status broadcast to the team.",
            "maxLength": 500,
            "example": "wrote 500 words today. skipped the run."
          },
          "mediaId": {
            "type": "string",
            "description": "Optional photo — media id from the presign upload path (screen 12's 📷 chip)."
          }
        },
        "required": [
          "text"
        ]
      },
      "GoalWeekRowDto": {
        "type": "object",
        "properties": {
          "goalId": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "mentorPersonalityId": {
            "type": "string"
          },
          "mentorName": {
            "type": "string"
          },
          "thisWeekCount": {
            "type": "number",
            "description": "Completions logged this week (Mon–Sun)."
          },
          "lastWeekCount": {
            "type": "number",
            "description": "Completions logged the prior week."
          },
          "delta": {
            "type": "number",
            "description": "thisWeekCount − lastWeekCount."
          },
          "trend": {
            "type": "string",
            "enum": [
              "up",
              "flat",
              "down"
            ]
          },
          "danger": {
            "type": "boolean",
            "description": "No completions this week — the row to talk about."
          },
          "commentary": {
            "type": "string",
            "description": "The goal's mentor reacting to the week, in voice."
          }
        },
        "required": [
          "goalId",
          "title",
          "mentorPersonalityId",
          "mentorName",
          "thisWeekCount",
          "lastWeekCount",
          "delta",
          "trend",
          "danger",
          "commentary"
        ]
      },
      "WeeklyReviewDto": {
        "type": "object",
        "properties": {
          "weekStart": {
            "type": "string",
            "description": "Monday 00:00 of the week under review (ISO)."
          },
          "weekEnd": {
            "type": "string",
            "description": "Sunday 23:59:59 of the week under review (ISO)."
          },
          "weekNumber": {
            "type": "number",
            "description": "ISO week number."
          },
          "onTrackCount": {
            "type": "number",
            "description": "Goals with at least one completion this week."
          },
          "totalGoals": {
            "type": "number"
          },
          "goals": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/GoalWeekRowDto"
            }
          }
        },
        "required": [
          "weekStart",
          "weekEnd",
          "weekNumber",
          "onTrackCount",
          "totalGoals",
          "goals"
        ]
      }
    }
  }
}