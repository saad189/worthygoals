# Copy to .env.local and fill in your keys

# API base URL.
# On a SIMULATOR/EMULATOR, http://localhost:3000 works.
# On a PHYSICAL PHONE (Expo Go / dev build), `localhost` resolves to the phone
# itself, not your dev machine — you'll get "Could not connect to Server".
# Use your dev machine's LAN IP instead (same Wi-Fi), e.g.:
#   EXPO_PUBLIC_API_URL=http://192.168.1.30:3000
# Find it with: ipconfig getifaddr en0   (macOS)
# Or point at a deployed backend (e.g. a Railway URL).
EXPO_PUBLIC_API_URL=http://localhost:3000

# Sentry — https://sentry.io → your project → Settings → Client Keys
EXPO_PUBLIC_SENTRY_DSN=

# PostHog — https://us.posthog.com → your project → Project Settings
EXPO_PUBLIC_POSTHOG_KEY=
