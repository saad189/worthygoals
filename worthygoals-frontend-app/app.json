{
  "expo": {
    "name": "Worthy Goals",
    "slug": "worthygoals-frontend-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/evolve-icon.png",
    "scheme": "myapp",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "cover",
      "backgroundColor": "#464546"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.saad189.worthygoalsfrontendapp"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/evolve-icon.png",
        "backgroundColor": "#464546"
      },
      "package": "com.saad189.worthygoalsfrontendapp"
    },
    "androidStatusBar": {
      "backgroundColor": "#464546",
      "hidden": true,
      "translucent": true
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/evolve-icon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "ad5aec6f-3fbe-41d0-8bde-6f4cb1b432c1"
      }
    }
  }
}
