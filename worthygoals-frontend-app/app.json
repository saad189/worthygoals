{
  "expo": {
    "name": "Worthy Goals",
    "slug": "worthygoals-frontend-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/worthy-goals-icon.png",
    "scheme": "myapp",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/images/worthy-goals-splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#F4EFE3"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.saad189.worthygoalsfrontendapp"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/worthy-goals-adaptive.png",
        "backgroundColor": "#C04124"
      },
      "package": "com.saad189.worthygoalsfrontendapp"
    },
    "androidStatusBar": {
      "backgroundColor": "#464546",
      "hidden": true,
      "translucent": true
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/worthy-goals-favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-notifications"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "ad5aec6f-3fbe-41d0-8bde-6f4cb1b432c1"
      }
    }
  }
}
