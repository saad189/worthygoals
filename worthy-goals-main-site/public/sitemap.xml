<?xml version="1.0" encoding="UTF-8"?>
<!--
  Indexable routes only. /thank-you is deliberately absent: it is a
  post-signup confirmation, marked noindex and disallowed in robots.txt.

  Kept as a static file because the route list is static (app.routes.ts).
  If routes ever become dynamic, generate this at build time from the same
  source instead of maintaining two lists.
-->
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url>
    <loc>https://worthygoals.web.app/</loc>
    <changefreq>weekly</changefreq>
    <priority>1.0</priority>
  </url>
  <url>
    <loc>https://worthygoals.web.app/privacy</loc>
    <changefreq>yearly</changefreq>
    <priority>0.3</priority>
  </url>
  <url>
    <loc>https://worthygoals.web.app/contact</loc>
    <changefreq>yearly</changefreq>
    <priority>0.5</priority>
  </url>
</urlset>
